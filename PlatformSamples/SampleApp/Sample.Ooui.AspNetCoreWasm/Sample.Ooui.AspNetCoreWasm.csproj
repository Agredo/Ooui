<Project Sdk="Microsoft.NET.Sdk">

  <!-- Both rendering paths of Ooui in one process: the shared MAUI app is rendered by Kestrel at /
       and by WebAssembly under /wasm. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Ooui.Maui\Ooui.Maui.csproj" />
    <ProjectReference Include="..\..\..\Ooui.AspNetCore\Ooui.AspNetCore.csproj" />
    <ProjectReference Include="..\Sample.Maui\Sample.Maui.csproj" />
    <ProjectReference Include="..\Sample.Models\Sample.Models.csproj" />
    <ProjectReference Include="..\Sample.Services\Sample.Services.csproj" />
  </ItemGroup>

</Project>
