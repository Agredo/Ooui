<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AspNetCoreMaui"
             x:Class="AspNetCoreMaui.Pages.CounterPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:Theme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Spacing="20">
        <Label Style="{StaticResource Heading}" Text="Counter" />
        <Label Style="{StaticResource Lead}"
               Text="Each click travels to the server over this page's WebSocket and back." />

        <Border Style="{StaticResource Card}" Padding="28">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <Label x:Name="ValueLabel"
                       AutomationId="count"
                       FontSize="64"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Accent}" />
                <HorizontalStackLayout Spacing="12">
                    <Button Style="{StaticResource Secondary}"
                            AutomationId="decrement"
                            Text="−1"
                            Clicked="OnDecrementClicked" />
                    <Button Style="{StaticResource Primary}"
                            AutomationId="increment"
                            Text="+1"
                            Clicked="OnIncrementClicked" />
                    <Button Style="{StaticResource Secondary}"
                            AutomationId="reset"
                            Text="Reset"
                            Clicked="OnResetClicked" />
                </HorizontalStackLayout>
                <Label x:Name="StatusLabel" Style="{StaticResource Small}" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource CardHeading}" Text="Why does the number stay?" />
                <Label Style="{StaticResource Small}"
                       Text="The counter lives in the user session of this browser, not in the page and not in the tab." />
                <Label Style="{StaticResource Small}"
                       Text="Visit another page or reload: the number is still there. Open the site in a second browser and you get a second session, starting at 0." />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>

</ContentPage>
