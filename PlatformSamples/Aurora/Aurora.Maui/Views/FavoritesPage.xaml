<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace=Aurora.Maui.Views;assembly=Aurora.Maui"
             xmlns:maui="clr-namespace=Aurora.Maui"
             xmlns:vm="clr-namespace=Aurora.ViewModels;assembly=Aurora.ViewModels"
             x:Class="Aurora.Maui.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Style="{StaticResource Page}"
             Title="Your saved places — Aurora">
  <ScrollView>
    <VerticalStackLayout Spacing="26" Padding="0,26,0,48">
      <Grid ColumnDefinitions="*,Auto">
        <HorizontalStackLayout Spacing="10">
          <Button Text="←" Style="{StaticResource IconButton}" BackgroundColor="Transparent" Command="{Binding ExploreCommand}" AutomationId="favorites-back" />
          <Label Text="aurora" Style="{StaticResource Brand}" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <Button Grid.Column="1" Text="Find a new place ↗" Style="{StaticResource PrimaryButton}" Command="{Binding ExploreCommand}" HeightRequest="44" />
      </Grid>
      <Border BackgroundColor="{StaticResource Peach}" Padding="32" StrokeThickness="0">
        <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
        <VerticalStackLayout Spacing="12">
          <Label Text="YOUR SOMEDAY, STARTING HERE" Style="{StaticResource Eyebrow}" />
          <Label Text="Places you couldn't stop thinking about." Style="{StaticResource Title}" AutomationId="favorites-title" />
          <Label Text="{Binding Summary}" Style="{StaticResource Body}" TextColor="{StaticResource Forest}" />
        </VerticalStackLayout>
      </Border>
      <CollectionView ItemsSource="{Binding SavedDestinations}" SelectionMode="None" AutomationId="favorites-list">
        <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="24" VerticalItemSpacing="26" /></CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate><StaticResourceExtension Key="DestinationCardTemplate" /></CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
          <Border Style="{StaticResource Card}" Padding="40">
            <VerticalStackLayout Spacing="16">
              <Label Text="♡" FontSize="52" TextColor="{StaticResource Clay}" />
              <Label Text="A little space for a big adventure." Style="{StaticResource Title}" />
              <Label Text="Save a journey with the heart on its photo. It will be right here when you come back." Style="{StaticResource Body}" />
              <Button Text="Find your kind of away ↗" Style="{StaticResource PrimaryButton}" Command="{Binding ExploreCommand}" AutomationId="empty-explore" />
            </VerticalStackLayout>
          </Border>
        </CollectionView.EmptyView>
      </CollectionView>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
