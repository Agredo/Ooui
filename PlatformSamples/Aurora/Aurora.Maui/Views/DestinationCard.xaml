<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace=Aurora.ViewModels;assembly=Aurora.ViewModels"
             x:Class="Aurora.Maui.Views.DestinationCard"
             x:DataType="vm:DestinationCardViewModel">
  <Border Style="{StaticResource Card}" Padding="0" AutomationId="destination-card">
    <VerticalStackLayout Spacing="0">
      <Grid HeightRequest="220" IsClippedToBounds="True" AutomationId="card-media">
        <Image Grid.Row="0" Grid.Column="0" Source="{Binding ImageUrl, Converter={StaticResource RelativeImageSource}}" Aspect="AspectFill" HeightRequest="220" />
        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F2FFFEFA" Padding="11,6" HorizontalOptions="Start" VerticalOptions="Start" Margin="16" StrokeThickness="0">
          <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
          <Label Text="{Binding Category, StringFormat='{0} escape'}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Forest}" CharacterSpacing="0.8" />
        </Border>
        <Button Grid.Row="0" Grid.Column="0" Text="{Binding FavoriteIcon}" Style="{StaticResource IconButton}" Command="{Binding ToggleFavoriteCommand}" HorizontalOptions="End" VerticalOptions="Start" Margin="16" Shadow="{StaticResource FloatingShadow}" AutomationId="favorite-button" />
      </Grid>
      <VerticalStackLayout Padding="22,20,22,22" Spacing="11">
        <Grid ColumnDefinitions="*,Auto">
          <Label Text="{Binding Destination.Name}" FontFamily="Georgia" FontSize="27" TextColor="{StaticResource Ink}" />
          <Label Grid.Column="1" Text="{Binding Rating}" FontSize="12" TextColor="{StaticResource Clay}" VerticalOptions="Center" />
        </Grid>
        <Label Text="{Binding Location}" Style="{StaticResource Small}" />
        <Label Text="{Binding Destination.Description}" Style="{StaticResource Body}" MinimumHeightRequest="65" />
        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" Margin="0,5" />
        <HorizontalStackLayout Spacing="18">
          <Label Text="{Binding Destination.Duration, StringFormat='◷  {0}'}" Style="{StaticResource Small}" />
          <Label Text="{Binding Destination.Season, StringFormat='☼  {0}'}" Style="{StaticResource Small}" />
        </HorizontalStackLayout>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,8,0,0">
          <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <Label Text="YOUR NEXT CHAPTER" FontSize="9" TextColor="{StaticResource Muted}" CharacterSpacing="1" />
            <Label Text="{Binding Price}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Forest}" />
          </VerticalStackLayout>
          <Button Grid.Column="1" Text="Discover  ↗" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" HeightRequest="44" AutomationId="open-destination" />
        </Grid>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </Border>
</ContentView>
